// Sistem SPK Eksternal Direktorat 3 Industrial Service — MySQL Laragon.
// Satu Order mengikuti alur RFQ → Silabus & RAK → Quotation → PO → SPK (2 approval)
// → persiapan DPS → pelaksanaan → laporan → BAST.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Peran {
  admin
  marketing
  kadep_marketing
  dps
  kadep_dps
  upt
}

enum JenisLayanan {
  TRAINING
  SERTIFIKASI
  KOMBINASI
  KONSULTASI
  SEWA_RUANG
}

enum JenisCustomer {
  SWASTA
  BUMN
  INSTITUSI
}

enum StatusOrder {
  RFQ
  SILABUS_RAK
  QUOTATION
  SPK_DRAF
  APPROVAL_1
  APPROVAL_2
  PERSIAPAN
  PELAKSANAAN
  LAPORAN
  SELESAI
  DITOLAK
  BATAL
}

enum StatusQuotation {
  DIKIRIM
  DISETUJUI
  DITOLAK
  DIGANTI
}

enum JenisPo {
  PO
  APPROVAL_QUOTATION
}

enum StatusPengajar {
  USULAN
  MENUNGGU
  BERSEDIA
  MENOLAK
}

enum StatusPp {
  DIAJUKAN
  DIPROSES
  DITERIMA
}

enum JenisFasilitas {
  RUANG_KELAS
  LABORATORIUM
  AULA
}

model Unit {
  id    Int    @id @default(autoincrement())
  /// Kode singkat, mis. INF.
  kode  String @unique @db.VarChar(8)
  nama  String @unique @db.VarChar(100)

  users    User[]
  pengajar Pengajar[]
  orders   Order[]

  @@map("unit")
}

model User {
  id           Int      @id @default(autoincrement())
  nama         String   @db.VarChar(100)
  username     String   @unique @db.VarChar(20)
  passwordHash String   @db.VarChar(255)
  peran        Peran
  jabatan      String   @db.VarChar(100)
  /// UPT/Prodi asal (untuk peran upt).
  unitId       Int?
  aktif        Boolean  @default(true)
  createdAt    DateTime @default(now())

  unit       Unit?               @relation(fields: [unitId], references: [id])
  orders     Order[]             @relation("OrderMarketing")
  riwayat    RiwayatOrder[]
  jadwalLog  JadwalLog[]
  approval1  Spk[]               @relation("Approval1")
  approval2  Spk[]               @relation("Approval2")
  notifikasi Notifikasi[]

  @@map("users")
}

/// Pengajar/instruktur sebagai data master (tidak login). Kesediaan dikonfirmasi lewat DPS.
model Pengajar {
  id        Int     @id @default(autoincrement())
  nama      String  @db.VarChar(100)
  jabatan   String  @db.VarChar(100)
  /// UPT/Prodi asal; kosong untuk pengajar eksternal.
  unitId    Int?
  eksternal Boolean @default(false)
  telepon   String? @db.VarChar(30)
  aktif     Boolean @default(true)

  unit      Unit?               @relation(fields: [unitId], references: [id])
  penugasan PenugasanPengajar[]

  @@map("pengajar")
}

model Customer {
  id        Int           @id @default(autoincrement())
  nama      String        @unique @db.VarChar(150)
  jenis     JenisCustomer
  pic       String        @db.VarChar(100)
  email     String?       @db.VarChar(120)
  telepon   String?       @db.VarChar(30)
  alamat    String?       @db.Text
  createdAt DateTime      @default(now())

  orders Order[]

  @@map("customer")
}

/// Batas waktu tiap tahap order (hari). Tahap PERSIAPAN & PELAKSANAAN mengikuti tanggal pelaksanaan.
model Sla {
  status StatusOrder @id
  hari   Int         @db.SmallInt

  @@map("sla")
}

model Order {
  id            Int          @id @default(autoincrement())
  nomorRfq      String       @unique @db.VarChar(30)
  customerId    Int
  marketingId   Int
  jenis         JenisLayanan
  judul         String       @db.VarChar(150)
  deskripsi     String       @db.Text
  tglMulai      DateTime     @db.Date
  tglSelesai    DateTime     @db.Date
  lokasi        String       @db.VarChar(150)
  jumlahPeserta Int?         @db.SmallInt
  /// Atribut khusus per jenis layanan (Dynamic JSON Field).
  detail        Json
  status        StatusOrder  @default(RFQ)
  /// Awal tahap saat ini, untuk menghitung SLA.
  tahapMulai    DateTime     @default(now())
  /// Status terakhir yang sudah dikirimi pengingat lewat SLA (agar tidak berulang).
  pengingatSla  StatusOrder?
  /// UPT/Prodi yang menyusun silabus & RAK.
  unitId        Int?
  alasanTutup   String?      @db.Text
  createdAt     DateTime     @default(now())

  customer   Customer            @relation(fields: [customerId], references: [id])
  marketing  User                @relation("OrderMarketing", fields: [marketingId], references: [id])
  unit       Unit?               @relation(fields: [unitId], references: [id])
  riwayat    RiwayatOrder[]
  silabus    Silabus?
  rakItem    RakItem[]
  quotation  Quotation[]
  po         PurchaseOrder?
  spk        Spk?
  jadwalLog  JadwalLog[]
  pengajar   PenugasanPengajar[]
  pp         PurchaseRequest[]
  booking    BookingFasilitas[]
  laporan    LaporanKegiatan?
  bast       Bast?

  @@index([status])
  @@map("order")
}

/// Audit trail setiap perubahan tahap dan keputusan.
model RiwayatOrder {
  id         Int          @id @default(autoincrement())
  orderId    Int
  olehId     Int
  dari       StatusOrder?
  ke         StatusOrder
  catatan    String?      @db.Text
  dibuatPada DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oleh  User  @relation(fields: [olehId], references: [id])

  @@map("riwayat_order")
}

/// Request Silabus & RAK: Marketing → DPS → UPT/Prodi → kembali ke Marketing.
model Silabus {
  id               Int       @id @default(autoincrement())
  orderId          Int       @unique
  catatanMarketing String?   @db.Text
  tenggat          DateTime  @db.Date
  diteruskanPada   DateTime?
  ringkasan        String?   @db.Text
  berkas           String?   @db.VarChar(255)
  dikirimPada      DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("silabus")
}

/// Rancangan Anggaran Kegiatan per item biaya.
model RakItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  uraian      String  @db.VarChar(150)
  volume      Int     @db.SmallInt
  satuan      String  @db.VarChar(30)
  hargaSatuan Decimal @db.Decimal(15, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("rak_item")
}

model Quotation {
  id             Int             @id @default(autoincrement())
  orderId        Int
  nomor          String          @unique @db.VarChar(40)
  versi          Int             @db.SmallInt
  nilaiRak       Decimal         @db.Decimal(15, 2)
  marginPersen   Decimal         @db.Decimal(7, 2)
  nilaiPenawaran Decimal         @db.Decimal(15, 2)
  berlakuSampai  DateTime        @db.Date
  catatan        String?         @db.Text
  status         StatusQuotation @default(DIKIRIM)
  dibuatPada     DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("quotation")
}

model PurchaseOrder {
  id       Int      @id @default(autoincrement())
  orderId  Int      @unique
  jenis    JenisPo
  nomor    String   @db.VarChar(60)
  tanggal  DateTime @db.Date
  nilai    Decimal  @db.Decimal(15, 2)
  lampiran String?  @db.VarChar(255)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_order")
}

model Spk {
  id           Int       @id @default(autoincrement())
  orderId      Int       @unique
  /// Nomor resmi, terbit setelah approval 2.
  nomor        String?   @unique @db.VarChar(40)
  ruangLingkup String    @db.Text
  budgetRak    Decimal   @db.Decimal(15, 2)
  nilaiKontrak Decimal   @db.Decimal(15, 2)
  catatan      String?   @db.Text
  approval1Id  Int?
  approval1Pada DateTime?
  approval2Id  Int?
  approval2Pada DateTime?
  alasanTolak  String?   @db.Text
  dibuatPada   DateTime  @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  approver1 User? @relation("Approval1", fields: [approval1Id], references: [id])
  approver2 User? @relation("Approval2", fields: [approval2Id], references: [id])

  @@map("spk")
}

/// Schedule Adjustment Log: perubahan tanggal tanpa membatalkan SPK.
model JadwalLog {
  id         Int      @id @default(autoincrement())
  orderId    Int
  olehId     Int
  mulaiLama  DateTime @db.Date
  selesaiLama DateTime @db.Date
  mulaiBaru  DateTime @db.Date
  selesaiBaru DateTime @db.Date
  alasan     String   @db.Text
  dibuatPada DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oleh  User  @relation(fields: [olehId], references: [id])

  @@map("jadwal_log")
}

model PenugasanPengajar {
  id              Int            @id @default(autoincrement())
  orderId         Int
  pengajarId      Int
  peran           String         @db.VarChar(60)
  status          StatusPengajar @default(USULAN)
  alasan          String?        @db.Text
  nomorSuratTugas String?        @unique @db.VarChar(40)
  suratTugasPada  DateTime?
  dibuatPada      DateTime       @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pengajar Pengajar @relation(fields: [pengajarId], references: [id])

  @@unique([orderId, pengajarId])
  @@map("penugasan_pengajar")
}

/// Permintaan Pembelian (PP) material ke Finance/Purchasing.
model PurchaseRequest {
  id            Int      @id @default(autoincrement())
  orderId       Int
  item          String   @db.VarChar(150)
  jumlah        Int      @db.SmallInt
  satuan        String   @db.VarChar(30)
  estimasiHarga Decimal  @db.Decimal(15, 2)
  status        StatusPp @default(DIAJUKAN)
  dibuatPada    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_request")
}

model Fasilitas {
  id        Int            @id @default(autoincrement())
  nama      String         @unique @db.VarChar(100)
  jenis     JenisFasilitas
  kapasitas Int            @db.SmallInt

  booking BookingFasilitas[]

  @@map("fasilitas")
}

model BookingFasilitas {
  id          Int      @id @default(autoincrement())
  orderId     Int
  fasilitasId Int
  mulai       DateTime @db.Date
  selesai     DateTime @db.Date

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fasilitas Fasilitas @relation(fields: [fasilitasId], references: [id])

  @@unique([orderId, fasilitasId])
  @@map("booking_fasilitas")
}

model LaporanKegiatan {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique
  ringkasan   String   @db.Text
  jumlahHadir Int?     @db.SmallInt
  kendala     String?  @db.Text
  lampiran    String?  @db.VarChar(255)
  dikirimPada DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("laporan_kegiatan")
}

/// Berita Acara Serah Terima untuk penagihan customer.
model Bast {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique
  nomor      String   @unique @db.VarChar(40)
  tanggal    DateTime @db.Date
  catatan    String?  @db.Text
  dibuatPada DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("bast")
}

model Notifikasi {
  id         Int      @id @default(autoincrement())
  userId     Int
  pesan      String   @db.VarChar(255)
  tautan     String   @db.VarChar(255)
  dibaca     Boolean  @default(false)
  dibuatPada DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dibaca])
  @@map("notifikasi")
}
